# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Applies repo-wide (frontend/, backend/, and root) — patterns are unanchored on purpose
# so they match node_modules/build output no matter which subproject it's under.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js (frontend)
.next/
out/

# backend build output
dist/

# production
build

# misc
.DS_Store
*.pem
novrsoc-key.pem
novrsoc-infra.env

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
*.env
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
