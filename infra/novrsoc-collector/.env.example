# NovrSOC Collector V1 — environment template. Copy to `.env` (gitignored) and fill in.
# Never commit the real .env. Nothing here carries a default secret or a client identity.

# ── Required: issued by NovrSOC when a staff member enrolls this collector ──────────────────
# Staff → Collector Management → New collector. The response is shown ONCE — paste it here
# immediately; there is no way to view it again (use "Rotate" in the UI if it's lost).
# Format: "<collector-id>.<secret>" — a single string, not two separate values.
NOVRSOC_COLLECTOR_TOKEN=

# The NovrSOC backend this collector reports to. No trailing slash.
NOVRSOC_BACKEND_URL=https://your-novrsoc-backend.example

# ── Syslog listener ports (host-side; change if 514/6514 etc. are already in use) ───────────
SYSLOG_TCP_PORT=6514
SYSLOG_UDP_PORT=5514
SYSLOG_TLS_PORT=6515

# Require a client certificate on the TLS syslog listener. Leave false unless every sender in
# your fleet can actually present one (most legacy/agentless senders cannot).
NOVRSOC_SYSLOG_TLS_VERIFY_CLIENT=false

# ── Heartbeat sidecar ─────────────────────────────────────────────────────────────────────────
HEARTBEAT_INTERVAL_SECONDS=60
# Internal only — the compose network's own service name, never exposed to the host or internet.
VECTOR_METRICS_URL=http://vector:9598/metrics
VECTOR_HEALTH_URL=http://vector:8686/health
