# Copy to /opt/novrsoc/soar.env on the Wazuh manager, fill in, then:
#   chown root:wazuh /opt/novrsoc/soar.env && chmod 640 /opt/novrsoc/soar.env

# Required — where cases are written.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# IOC enrichment. Must equal SOAR_ENGINE_TOKEN on the Railway backend (generate once:
#   openssl rand -hex 32). Unset -> enrichment skipped and logged as skipped.
NOVRSOC_BACKEND=https://novrsoc-production-1fb6.up.railway.app
SOAR_ENGINE_TOKEN=
NOVRSOC_APP_URL=https://novr-soc.vercel.app
NOVRSOC_ORG_ID=cybernovr

# Notifications. Unset -> that step is skipped and logged as skipped.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (cybernovr.com; novrsoc.com is not verified).
RESEND_FROM=NovrSOC by Cybernovr <alerts@cybernovr.com>
CISO_EMAIL=soc@cybernovr.com
# Team notifications. Defaults to CISO_EMAIL.
SOC_EMAIL=soc@cybernovr.com

# F-07 (2026 redesign): block_ip() and isolate_agent() no longer call OPNsense or Wazuh active
# response directly from here. Tier 2/3 alerts now request approval from the backend
# (SOAR_ENGINE_TOKEN, below), and the block/isolate runs there, with the BACKEND's own OPNsense/
# Wazuh configuration (Railway/Render env) — not this host's. The four settings below are no
# longer read by this script; kept only so an existing soar.env does not need editing.
#
# IP blocking (tiers 2 and 3) — now configured on the backend, not here.
OPNSENSE_URL=
OPNSENSE_KEY=
OPNSENSE_SECRET=
OPNSENSE_ALIAS=novrsoc_blocked
OPNSENSE_VERIFY_TLS=false

# Agent isolation (tier 3, techniques T1486/T1021/T1055/T1210) — now configured on the backend,
# not here; WAZUH_ISOLATE_COMMAND is unused. WAZUH_API_URL/WAZUH_USER/WAZUH_PASSWORD below are
# still required — the alert forwarder (--forward) uses them to read agent-to-group mappings.
WAZUH_API_URL=https://localhost:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=false
WAZUH_ISOLATE_COMMAND=

SOAR_LOG_FILE=/var/log/novrsoc-soar.log

# ── Alert forwarder (soar.py --forward, phase R2) ──
# Distinct from SOAR_ENGINE_TOKEN; must equal ALERT_INGEST_TOKEN on the backend.
ALERT_INGEST_TOKEN=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_ALERTS_INDEX=
SOAR_CURSOR_FILE=
SOAR_BACKFILL_HOURS=
SOAR_FORWARD_INTERVAL=
SOAR_FORWARD_BATCH=
SOAR_FORWARD_OVERLAP_SECONDS=
SOAR_FORWARD_MIN_LEVEL=
# Read only alerts at least this many seconds old (default 60), so late-indexed ones are read in order.
SOAR_FORWARD_SETTLE_SECONDS=
# Re-send the overlap window behind the checkpoint every N cycles (default 10; 0 = never), at most
# SOAR_FORWARD_LATE_MAX_PAGES pages (default 5). Duplicates are ignored by the backend.
SOAR_FORWARD_LATE_EVERY=
SOAR_FORWARD_LATE_MAX_PAGES=
