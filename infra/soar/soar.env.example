# Copy to /opt/novrsoc/soar.env on the Wazuh manager, fill in, then:
#   chown root:wazuh /opt/novrsoc/soar.env && chmod 640 /opt/novrsoc/soar.env

# Required — where cases are written.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# IOC enrichment. Must equal SOAR_ENGINE_TOKEN on the Railway backend (generate once:
#   openssl rand -hex 32). Unset -> enrichment skipped and logged as skipped.
NOVRSOC_BACKEND=https://novrsoc-production-1fb6.up.railway.app
SOAR_ENGINE_TOKEN=
NOVRSOC_APP_URL=https://novr-soc.vercel.app
NOVRSOC_ORG_ID=cybernovr

# Notifications. Unset -> that step is skipped and logged as skipped.
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
RESEND_FROM=NovrSOC Alerts <alerts@cybernovr.com>
CISO_EMAIL=rayne@cybernovr.com

# IP blocking (tiers 2 and 3). OPNsense API key + secret, alias of type Host(s) that a block
# rule references. Unset -> blocking skipped and logged as skipped.
OPNSENSE_URL=
OPNSENSE_KEY=
OPNSENSE_SECRET=
OPNSENSE_ALIAS=novrsoc_blocked
OPNSENSE_VERIFY_TLS=false

# Agent isolation (tier 3, techniques T1486/T1021/T1055/T1210). The engine runs on the manager,
# so the API is local. WAZUH_ISOLATE_COMMAND must name an active response you have deployed to
# agents — Wazuh ships none that isolates a host. Unset -> isolation skipped and logged.
WAZUH_API_URL=https://localhost:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=false
WAZUH_ISOLATE_COMMAND=

SOAR_LOG_FILE=/var/log/novrsoc-soar.log
