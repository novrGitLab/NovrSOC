# NovrSOC VMS scanner worker — copy to /opt/novrsoc-vms/worker.env (chmod 600). Names only here.
# The backend's https URL, e.g. https://<your-backend>.up.railway.app
NOVRSOC_API_URL=
# Same value as VMS_WORKER_TOKEN on Railway (at least 32 characters: `openssl rand -hex 32`).
VMS_WORKER_TOKEN=
VMS_WORKER_ID=vms-worker-1
# Job kinds this host runs: discovery, ports (Release 2 adds vuln_nuclei, vuln_openvas).
VMS_WORKER_KINDS=discovery,ports
VMS_POLL_SECONDS=20
VMS_TOOL_TIMEOUT_SECONDS=3600
# Politeness limits: httpx requests per second, nmap packets per second.
VMS_HTTPX_RATE=50
VMS_NMAP_MAX_RATE=300
# Optional explicit tool paths (default: found on PATH)
# VMS_SUBFINDER_PATH=/usr/local/bin/subfinder

# ─── Release 2: vulnerability scanning ───
# Add vuln_nuclei and/or vuln_openvas to VMS_WORKER_KINDS to run them on this host.
VMS_NUCLEI_RATE=50
VMS_NUCLEI_SEVERITIES=low,medium,high,critical
# OpenVAS / Greenbone (only if installed on this host; needs `pip install python-gvm`):
GVM_SOCKET=/run/gvmd/gvmd.sock
GVM_USER=
GVM_PASSWORD=
