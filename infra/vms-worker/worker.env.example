# NovrSOC VMS scanner worker — copy to /opt/novrsoc-vms/worker.env (chmod 600). Names only here.
# The backend's https URL, e.g. https://<your-backend>.up.railway.app
NOVRSOC_API_URL=
# Same value as VMS_WORKER_TOKEN on Railway (at least 32 characters: `openssl rand -hex 32`).
VMS_WORKER_TOKEN=
VMS_WORKER_ID=vms-worker-1
# Job kinds this host runs: discovery, ports (Release 2 adds vuln_nuclei, vuln_openvas).
VMS_WORKER_KINDS=discovery,ports
# Worker heartbeat to the backend (seconds) and how often a status line is logged (seconds).
VMS_PRESENCE_SECONDS=60
VMS_STATUS_LOG_SECONDS=600
VMS_POLL_SECONDS=20
VMS_TOOL_TIMEOUT_SECONDS=3600
# Politeness limits: httpx requests per second, nmap packets per second.
VMS_HTTPX_RATE=50
VMS_NMAP_MAX_RATE=300
# Private networks this host can actually reach, comma-separated CIDRs (e.g. a VPN into a client LAN).
# Private/link-local/CGNAT targets outside these are not scanned: the job reports "no route" with the
# reason. Leave empty on a public VPS.
VMS_WORKER_NETWORKS=
# Optional explicit tool paths (default: found on PATH)
# VMS_SUBFINDER_PATH=/usr/local/bin/subfinder

# ─── Release 2: vulnerability scanning ───
# Add vuln_nuclei and/or vuln_openvas to VMS_WORKER_KINDS to run them on this host.
VMS_NUCLEI_RATE=50
VMS_NUCLEI_SEVERITIES=low,medium,high,critical
# OpenVAS / Greenbone (worker 1.8.0; setup and troubleshooting: docs/runbooks/vms-openvas.md).
# The worker talks to gvmd over its LOCAL socket: no Greenbone port (9390/9392/443) is opened or used.
# Needs python-gvm (`sudo apt-get install python3-gvm`) and the novrsoc-vms user in the socket's group.
GVM_SOCKET=/run/gvmd/gvmd.sock
# A dedicated, non-admin Greenbone user for NovrSOC. Secret: this file only (chmod 600), never Railway.
GVM_USER=
GVM_PASSWORD=
# Scan configuration: must have safe checks on and vhost expansion off (expand_vhosts = no), or every
# vuln_openvas job is refused. Default: built-in "Full and fast"; see the runbook for a dedicated clone.
# GVM_CONFIG_ID=daba56c8-73ec-11df-a475-002264764cea
# GVM_SCANNER_ID=08b69003-5fc2-4037-a479-93b440211c73
# GVM_PORT_LIST_ID=33d0cd82-57c6-11e1-8ed1-406186ea4fc5
# Where expand_vhosts is read when the scan configuration does not set it:
# GVM_OPENVAS_CONF=/etc/openvas/openvas.conf
# Optional limits (defaults shown): whole scan, status poll interval, one GMP call.
# GVM_SCAN_TIMEOUT_SECONDS=14400
# GVM_POLL_SECONDS=30
# GVM_SOCKET_TIMEOUT_SECONDS=300
# Optional alive test, e.g. "Consider Alive" for hosts that drop ping (default: the configuration's).
# GVM_ALIVE_TEST=
