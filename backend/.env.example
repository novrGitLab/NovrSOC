# NovrSOC backend — example environment. Copy to backend/.env and fill in.
# NEVER commit real values: backend/.env is git-ignored; only this example is tracked.

# ── Environment & database safety (src/lib/runtimeEnv.ts, src/lib/envGuard.ts) ─────────────
# Outside production the backend REFUSES TO START unless SUPABASE_URL points at a database
# declared development/test here. Use a separate Supabase project for local work — never the
# production project. On Railway the environment is detected automatically.
NODE_ENV=development
NOVRSOC_ENV=development            # production | staging | development | test (Railway sets production itself)
SUPABASE_URL=                      # a DEVELOPMENT Supabase project, e.g. https://<dev-ref>.supabase.co
SUPABASE_SERVICE_KEY=              # that project's service-role key
SUPABASE_ENV=development           # what SUPABASE_URL is: development | test (production only on the production deployment)
NOVRSOC_PRODUCTION_SUPABASE_URLS=  # optional: comma-separated production project URLs, always refused outside production
NOVRSOC_DISABLE_JOBS=              # optional: true disables scheduled jobs that write
PORT=8000
MODE=

# ── Auth ─────────────────────────────────────────────────────────────────────────────────────
JWT_SECRET=
DEV_TOKEN_SECRET=
ENCRYPTION_KEY=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── URLs / CORS ──────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
APP_API_BASE_URL=
CTIP_API_URL=

# ── Email (platform notifications) ───────────────────────────────────────────────────────────
EMAIL_ENABLED=false
BREVO_API_KEY=
BREVO_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
CISO_EMAIL=

# ── Email Security ───────────────────────────────────────────────────────────────────────────
EMAIL_PROXY_TOKEN=                 # shared secret the Postfix/Amavis gateway sends as x-novrsoc-proxy-token (openssl rand -hex 32)
MAILGUN_WEBHOOK_SIGNING_KEY=       # Mailgun inbound route signing key (DMARC report inbox)
# Email Security domain verification (TXT _novrsoc-verification.<domain>). REQUIRED in production
# and staging: a dedicated random value of 32+ characters, different from JWT_SECRET
# (e.g. `openssl rand -hex 32`). Development/test fall back to JWT_SECRET when unset.
# Changing it invalidates every published verification record.
EMAILSEC_VERIFICATION_SECRET=
DMARC_RUA_ADDRESS=                 # report address used in suggested DMARC records
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=                 # https://<backend>/api/email-security/messaging/connections/microsoft365/callback
GOOGLE_WORKSPACE_SA_KEY=           # service-account JSON (raw or base64)
SANDBOX_URL=                       # optional CAPE sandbox
SANDBOX_TOKEN=

# ── TLS ──────────────────────────────────────────────────────────────────────────────────────
# Do NOT set NODE_TLS_REJECT_UNAUTHORIZED=0 — it disables certificate checks for every
# connection and is stripped at startup. Pin a self-signed service's certificate instead:
MISP_URL=
MISP_API_KEY=
MISP_CA_CERT=                      # MISP's certificate (PEM, \n-escaped, or base64)
# Threat Intelligence V1 (P25). Use a READ-ONLY MISP key. NovrSOC never writes to MISP unless this
# is exactly "true" (the Nigerian collector's IOC push); the Sources page warns if the key can write.
MISP_WRITE_ENABLED=
# MISP over a Cloudflare Tunnel (P26). MISP_URL is the tunnel's public https hostname (a normal
# Cloudflare certificate: leave MISP_CA_CERT empty). If an Access policy protects it, a service token:
MISP_CF_ACCESS_CLIENT_ID=
MISP_CF_ACCESS_CLIENT_SECRET=
MISP_BACKFILL_DAYS=                # first sync / default backfill window (default 7, max 90)
MISP_PAGE_SIZE=                    # records per restSearch page (default 1000)
MISP_MAX_PAGES=                    # pages per run (default 20); a run that hits it does not advance its window
MISP_PAGE_DELAY_MS=                # pause between pages (default 250)
MISP_MAX_ATTEMPTS=                 # attempts on network/429/5xx/tunnel errors (default 3, max 5)
TI_GEO_BATCH=                      # IP indicators located per 30-minute run (default 100)
# Ollama (self-hosted model) for the AI Intelligence Analyst. Never expose Ollama directly: run it
# on 127.0.0.1 behind a TLS reverse proxy that requires OLLAMA_API_KEY as a bearer token and only
# accepts the backend's outbound IPs (docs/runbooks/ti-v1.md). https only, except localhost.
TI_AI_PROVIDER=                    # "ollama" sends the TI purposes to Ollama; empty keeps AI_PROVIDER / NVIDIA
AI_PROVIDER=                       # "ollama" sends every AI purpose there; empty = NVIDIA
OLLAMA_URL=
OLLAMA_API_KEY=
OLLAMA_CA_CERT=                    # the proxy's certificate if self-signed (PEM, \n-escaped, or base64)
OLLAMA_MODEL=                      # default llama3.1:8b; must already be pulled on the server

# ── Wazuh / SOC integrations ─────────────────────────────────────────────────────────────────
WAZUH_HOST=
WAZUH_PORT=
WAZUH_USER=
WAZUH_PASSWORD=
WAZUH_INDEXER_HOST=
WAZUH_INDEXER_PORT=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
OPENCTI_URL=
OPENCTI_TOKEN=
SPIDERFOOT_URL=

# ── Threat intelligence & enrichment ─────────────────────────────────────────────────────────
NVIDIA_API_KEY=                    # AI provider (see "AI analysis" below). nvapi-… from build.nvidia.com; server-side only
GEMINI_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
URLHAUS_API_KEY=
THREATFOX_API_KEY=
NVD_API_KEY=
IPREGISTRY_API_KEY=
GOOGLE_API_KEY=
GOOGLE_VISION_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
GOOGLE_SEARCH_CX=
GITHUB_TOKEN=
GITLAB_TOKEN=
UPTIMEROBOT_API_KEY=
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=
CENSYS_API_ID=
CENSYS_API_SECRET=
SERPER_API_KEY=
GREYNOISE_API_KEY=

# ─── Stellar Cyber push (jobs/stellarPush.ts) — off unless ENABLED is exactly "true" ───
# Needs sql/2026-10-11_push_state.sql. Never commit the real API key.
STELLAR_PUSH_ENABLED=
STELLAR_PUSH_URL=
STELLAR_PUSH_API_KEY=
STELLAR_PUSH_ORG_IDS=
# Optional: STELLAR_PUSH_AUTH_HEADER (default Authorization), STELLAR_PUSH_AUTH_SCHEME (default
# Bearer; "none" sends the bare key), STELLAR_PUSH_PROFILE (standard | no_raw),
# STELLAR_PUSH_START (latest | hours:N | beginning, first run only), STELLAR_PUSH_MAX_PER_MIN
# (default 600), STELLAR_PUSH_TIMEOUT_MS (default 10000)

# ─── Automatic case creation (jobs/autoCase.ts) — off unless ENABLED is exactly "true" ───
# Opens cases from stored alerts: level >= MIN_LEVEL, repeats of one rule on one agent within
# GROUP_HOURS share a case, alerts stored within LOOKBACK_HOURS, at most MAX_NEW_PER_RUN per minute.
AUTO_CASE_ENABLED=
# Optional: AUTO_CASE_MIN_LEVEL (13), AUTO_CASE_GROUP_HOURS (24), AUTO_CASE_LOOKBACK_HOURS (24),
# AUTO_CASE_MAX_NEW_PER_RUN (25)

# ─── Staff sign-in (routes/auth.ts, phase P2) ───
# Accounts sign in with their own password once the P2 SQL runs. The DEV_ADMIN_* pair above is
# then a break-glass account: set DEV_ADMIN_LOGIN_ENABLED=false to switch it off.
DEV_ADMIN_LOGIN_ENABLED=
# Link base for one-time password links (and other links sent to people): the frontend's URL.
FRONTEND_URL=
# Minutes without a new stored alert before Platform Health flags ingestion (default 60).
ALERT_STALE_MINUTES=

# ─── AI analysis (services/ai.ts, services/nvidia.ts, routes/novr-ai.ts) ───
# NVIDIA API Catalog, OpenAI-compatible endpoint https://integrate.api.nvidia.com/v1, using
# NVIDIA_API_KEY above. AI_MODEL defaults to nvidia/nemotron-3-super-120b-a12b. AI_FALLBACK_MODEL
# is optional: if set, a refusal is retried once on it. AI_TIMEOUT_MS defaults to 120000.
# NovrAI chat falls back to Gemini (GEMINI_API_KEY) when NVIDIA is unset or fails.
AI_MODEL=
AI_FALLBACK_MODEL=
AI_TIMEOUT_MS=
# ─── Response approvals (services/responseApprovals.ts) ───
# Blocking an IP / isolating a host needs a second person's approval. Set to "true" only for a
# team of one, to let a manager approve their own request.
RESPONSE_ALLOW_SELF_APPROVAL=

# ─── VMS scanner worker (routes/vmsWorker.ts, infra/vms-worker) ───
# Shared secret the scanner worker presents (at least 32 characters: `openssl rand -hex 32`).
# Unset = the worker API refuses every call.
VMS_WORKER_TOKEN=
# OpenVAS execution policy (lib/openvasPolicy.ts). Off unless ENABLED is exactly "true", and then
# only for the scope ids listed (comma-separated UUIDs). Leave both unset until the scanner host and
# each target's authorisation for Greenbone scans are confirmed. Checked when a scan is queued and
# again when a worker claims it.
VMS_OPENVAS_ENABLED=
VMS_OPENVAS_SCOPE_IDS=

# ─── VMS Release 2 (jobs/vmsIntelJob.ts) ───
# CVE intelligence: CISA KEV and FIRST EPSS need no key. NVD works without one (5 requests / 30 s);
# a free NVD API key raises that to 50 (https://nvd.nist.gov/developers/request-an-api-key).
NVD_API_KEY=
# Set to "false" to stop the hourly Wazuh vulnerability sync and the 6-hourly CVE refresh.
VMS_INTEL_ENABLED=
