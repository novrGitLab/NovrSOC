{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test:apis": "tsx src/scripts/testAPIs.ts",
    "test:new-apis": "tsx src/scripts/testNewAPIs.ts",
    "test:new-keys": "tsx src/scripts/testNewKeys.ts",
    "test:four-keys": "tsx src/scripts/testFourKeys.ts",
    "test:google": "tsx src/scripts/testGoogleAPIs.ts",
    "geoip:download": "node scripts/downloadGeoIP.js",
    "security:audit": "npm audit --audit-level=high",
    "security:check": "npm audit --audit-level=moderate --json | node -e \"const d=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8')); if(d.metadata.vulnerabilities.high>0||d.metadata.vulnerabilities.critical>0) process.exit(1)\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@google/genai": "^2.19.0",
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.112.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "google-play-scraper": "^10.1.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "maxmind": "^5.0.7",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.6",
    "resend": "^6.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "tar": "^7.5.22",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
